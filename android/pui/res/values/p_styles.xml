<?xml version="1.0" encoding="utf-8"?>
<!-- pUI themes and widget styles. Managed by configs/android/pui: re-apply instead of editing in an app.
     App manifest: android:theme="@style/Theme.P" (no action bar) or "@style/Theme.P.Bar" (framework action bar).
     An app that needs extra theme items declares <style name="Theme.MyApp" parent="Theme.P"> in its own file. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">

    <!-- ================= themes ================= -->

    <style name="Theme.P" parent="Theme.P.Base">
        <item name="android:colorAccent">@color/p_accent</item>
        <item name="android:colorPrimary">@color/p_bg</item>
        <item name="android:colorPrimaryDark">@color/p_bg</item>
        <item name="android:colorBackground">@color/p_bg</item>
        <item name="android:colorControlNormal">@color/p_text2</item>
        <item name="android:colorControlActivated">@color/p_accent</item>
        <item name="android:colorControlHighlight">@color/p_ripple</item>
        <item name="android:textColorPrimary">@color/p_text</item>
        <item name="android:textColorSecondary">@color/p_text2</item>
        <item name="android:textColorHint">@color/p_text3</item>
        <item name="android:textColorLink">@color/p_accent_text</item>
        <item name="android:windowBackground">@color/p_bg</item>
        <item name="android:statusBarColor">@color/p_bg</item>
        <item name="android:navigationBarColor">@color/p_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">@bool/p_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/p_light_bars</item>
        <item name="android:buttonStyle">@style/P.Button.Tonal</item>
        <item name="android:borderlessButtonStyle">@style/P.Button.Text</item>
        <item name="android:editTextStyle">@style/P.Input</item>
        <item name="android:alertDialogTheme">@style/Theme.P.Dialog</item>
    </style>

    <!-- Same palette with the framework action bar (flat, page-colored). -->
    <style name="Theme.P.Bar" parent="Theme.P.Bar.Base">
        <item name="android:colorAccent">@color/p_accent</item>
        <item name="android:colorPrimary">@color/p_bg</item>
        <item name="android:colorPrimaryDark">@color/p_bg</item>
        <item name="android:colorBackground">@color/p_bg</item>
        <item name="android:colorControlNormal">@color/p_text2</item>
        <item name="android:colorControlActivated">@color/p_accent</item>
        <item name="android:colorControlHighlight">@color/p_ripple</item>
        <item name="android:textColorPrimary">@color/p_text</item>
        <item name="android:textColorSecondary">@color/p_text2</item>
        <item name="android:textColorHint">@color/p_text3</item>
        <item name="android:textColorLink">@color/p_accent_text</item>
        <item name="android:windowBackground">@color/p_bg</item>
        <item name="android:statusBarColor">@color/p_bg</item>
        <item name="android:navigationBarColor">@color/p_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">@bool/p_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/p_light_bars</item>
        <item name="android:buttonStyle">@style/P.Button.Tonal</item>
        <item name="android:borderlessButtonStyle">@style/P.Button.Text</item>
        <item name="android:editTextStyle">@style/P.Input</item>
        <item name="android:alertDialogTheme">@style/Theme.P.Dialog</item>
        <item name="android:actionBarStyle">@style/P.TopBar</item>
        <item name="android:actionOverflowMenuStyle">@style/P.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/P.PopupMenu</item>
    </style>

    <style name="Theme.P.Dialog" parent="Theme.P.Dialog.Base">
        <item name="android:colorAccent">@color/p_accent</item>
        <item name="android:colorBackground">@color/p_surface</item>
        <item name="android:windowBackground">@drawable/p_dialog_bg</item>
        <item name="android:textColorPrimary">@color/p_text</item>
        <item name="android:textColorSecondary">@color/p_text2</item>
        <item name="android:colorControlActivated">@color/p_accent</item>
        <item name="android:editTextStyle">@style/P.Input</item>
        <item name="android:buttonBarButtonStyle">@style/P.Button.Text</item>
    </style>

    <!-- ================= text ================= -->

    <style name="P.Text" parent="">
        <item name="android:textColor">@color/p_text</item>
        <item name="android:textSize">@dimen/p_text_body</item>
    </style>
    <style name="P.Text.Display">
        <item name="android:textSize">@dimen/p_text_display</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    <style name="P.Text.Title">
        <item name="android:textSize">@dimen/p_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="P.Text.Subtitle">
        <item name="android:textSize">@dimen/p_text_subtitle</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="P.Text.Body" />
    <style name="P.Text.Secondary">
        <item name="android:textColor">@color/p_text2</item>
    </style>
    <style name="P.Text.Label">
        <item name="android:textSize">@dimen/p_text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="P.Text.Caption">
        <item name="android:textSize">@dimen/p_text_caption</item>
        <item name="android:textColor">@color/p_text2</item>
    </style>
    <!-- Upper-case section header above a group of rows. -->
    <style name="P.Text.Section">
        <item name="android:textSize">@dimen/p_text_caption</item>
        <item name="android:textColor">@color/p_accent_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ================= buttons ================= -->

    <style name="P.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/p_btn_filled</item>
        <item name="android:textColor">@color/p_on_accent</item>
        <item name="android:textSize">@dimen/p_text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/p_button_height</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="P.Button.Tonal">
        <item name="android:background">@drawable/p_btn_tonal</item>
        <item name="android:textColor">@color/p_on_accent_soft</item>
    </style>
    <style name="P.Button.Neutral">
        <item name="android:background">@drawable/p_btn_neutral</item>
        <item name="android:textColor">@color/p_text</item>
    </style>
    <style name="P.Button.Outline">
        <item name="android:background">@drawable/p_btn_outline</item>
        <item name="android:textColor">@color/p_accent_text</item>
    </style>
    <style name="P.Button.Text">
        <item name="android:background">@drawable/p_btn_text</item>
        <item name="android:textColor">@color/p_accent_text</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="P.Button.Danger">
        <item name="android:background">@drawable/p_btn_danger</item>
        <item name="android:textColor">@color/p_danger</item>
    </style>
    <!-- Round icon button (ImageButton / TextView glyph). -->
    <style name="P.IconButton" parent="android:Widget.Material.ImageButton">
        <item name="android:background">@drawable/p_btn_text</item>
        <item name="android:minWidth">@dimen/p_touch</item>
        <item name="android:minHeight">@dimen/p_touch</item>
        <item name="android:tint">@color/p_text2</item>
        <item name="android:scaleType">center</item>
    </style>

    <!-- ================= containers ================= -->

    <style name="P.Card" parent="">
        <item name="android:background">@drawable/p_card</item>
        <item name="android:padding">@dimen/p_space_l</item>
    </style>
    <!-- Tappable list row inside a card or page: 56dp+ touch target, ripple. -->
    <style name="P.Row" parent="">
        <item name="android:background">@drawable/p_row</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">@dimen/p_space_l</item>
        <item name="android:paddingEnd">@dimen/p_space_s</item>
        <item name="android:paddingTop">@dimen/p_space_s</item>
        <item name="android:paddingBottom">@dimen/p_space_s</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="P.Divider" parent="">
        <item name="android:background">@color/p_line</item>
        <item name="android:layout_height">@dimen/p_line_width</item>
    </style>
    <style name="P.Chip" parent="">
        <item name="android:background">@drawable/p_chip</item>
        <item name="android:textColor">@color/p_text</item>
        <item name="android:textSize">@dimen/p_text_label</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="P.Input" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/p_input</item>
        <item name="android:textColor">@color/p_text</item>
        <item name="android:textColorHint">@color/p_text3</item>
        <item name="android:textSize">@dimen/p_text_subtitle</item>
        <item name="android:minHeight">@dimen/p_touch</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- ================= bars and menus ================= -->

    <style name="P.TopBar" parent="android:Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/p_bg</item>
        <item name="android:elevation">0dp</item>
        <item name="android:titleTextStyle">@style/P.TopBar.Title</item>
    </style>
    <style name="P.TopBar.Title" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/p_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="P.PopupMenu" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/p_popup_bg</item>
    </style>
</resources>
