<?xml version="1.0" encoding="utf-8"?>
<!-- pUI framework parents, LIGHT. values-night/p_theme_base.xml swaps them for the dark parents,
     so Theme.P / Theme.P.Bar follow the system dark mode. Managed by configs/android/pui. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">
    <style name="Theme.P.Base" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.P.Bar.Base" parent="android:Theme.Material.Light" />
    <style name="Theme.P.Dialog.Base" parent="android:Theme.Material.Light.Dialog.Alert" />
</resources>
